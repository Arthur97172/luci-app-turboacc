'use strict';

import * as core from 'turboacc.core';

return {
	'luci.turboacc': {
		getSystemFeatures: {
			call: function() {
				return core.detect();
			}
		},
		getStatus: {
			call: function() {
				return core.status();
			}
		}
	}
};
